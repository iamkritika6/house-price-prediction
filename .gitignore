# Data — never commit datasets or anything derived from them
# (data/* rather than data/, so the .gitkeep below can be re-included:
#  git cannot un-ignore a file inside an ignored *directory*)
data/*
!data/.gitkeep

# Generated outputs
#
# Figures ARE committed: the README embeds them, so they have to be in the
# repository to render on GitHub. They are small (~560 KB in total) and are
# regenerated by scripts/evaluate.py and scripts/explain_shap.py.
reports/metrics/*.json
models/*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Secrets — nothing credential-shaped should ever be tracked
.env
*.pem
*.key
kaggle.json
