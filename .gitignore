# Data — never commit datasets or anything derived from them
# (data/* rather than data/, so the .gitkeep below can be re-included:
#  git cannot un-ignore a file inside an ignored *directory*)
data/*
!data/.gitkeep

# Generated outputs
reports/figures/*.png
reports/metrics/*.json
models/*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Secrets — nothing credential-shaped should ever be tracked
.env
*.pem
*.key
kaggle.json
